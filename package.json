{
  "name": "stu-packet-tracer-mcp",
  "mcpName": "io.github.fuih/stu-packet-tracer-mcp",
  "version": "0.1.0",
  "description": "Student-focused Model Context Protocol (MCP) server for Cisco Packet Tracer 9 — design, build, inspect, and visualize network topologies, CLI terminals, and university lab reports in real-time.",
  "author": "fuih",
  "license": "MIT",
  "homepage": "https://github.com/fuih/stu-packet-tracer-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fuih/stu-packet-tracer-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/fuih/stu-packet-tracer-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "packet-tracer",
    "cisco-packet-tracer",
    "cisco",
    "networking",
    "network-simulation",
    "network-topology",
    "topology-generator",
    "ccna",
    "ccnp",
    "ios",
    "ospf",
    "eigrp",
    "bgp",
    "vlan",
    "nat",
    "acl",
    "voip",
    "qos",
    "ipv6",
    "wireless",
    "llm",
    "ai-agent",
    "claude",
    "chatgpt",
    "gemini",
    "anthropic",
    "openai",
    "ai-networking",
    "automation",
    "education",
    "bun",
    "typescript"
  ],
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "stu-packet-tracer-mcp": "src/index.ts"
  },
  "files": [
    "src",
    "assets",
    "extension/dist/*.pts",
    "AGENTS.md",
    "server.json",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --hot src/index.ts",
    "doctor": "bun run src/index.ts --doctor",
    "build": "bun build src/index.ts --compile --outfile dist/stu-packet-tracer-mcp",
    "typecheck": "tsc --noEmit",
    "check:english": "bun run scripts/check-english.ts",
    "docs:tools": "bun run scripts/gen-tools-doc.ts",
    "check:tools": "bun run scripts/gen-tools-doc.ts --check",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "ci": "bun run typecheck && bun run check:english && bun run check:tools && bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "docx": "^9.15.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^6.0.3"
  }
}
