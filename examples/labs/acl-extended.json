{
  "id": "acl-extended",
  "title": "Extended Named IPv4 ACL (HTTP/ICMP Filtering)",
  "summary": "Permit HTTP (TCP/80) to Server1 while blocking ICMP ping from 192.168.1.10, applied closest to the source inbound.",
  "learningObjectives": [
    "Author an extended named ACL (`ip access-list extended`) matching protocol, source, destination, and TCP port",
    "Apply extended ACLs closest to the source (`in` on LAN gateway interface)"
  ],
  "devices": [
    {
      "name": "PC1",
      "model": "PC-PT",
      "ptType": "PC-PT",
      "x": 140,
      "y": 240
    },
    {
      "name": "R1",
      "model": "2911",
      "ptType": "2911",
      "x": 380,
      "y": 240
    },
    {
      "name": "WebServer",
      "model": "Server-PT",
      "ptType": "Server-PT",
      "x": 620,
      "y": 240
    }
  ],
  "links": [
    {
      "from": "PC1",
      "fromPort": "FastEthernet0",
      "to": "R1",
      "toPort": "GigabitEthernet0/0",
      "cable": "cross"
    },
    {
      "from": "R1",
      "fromPort": "GigabitEthernet0/1",
      "to": "WebServer",
      "toPort": "FastEthernet0",
      "cable": "cross"
    }
  ],
  "pcs": [
    {
      "name": "PC1",
      "ip": "192.168.1.10",
      "mask": "255.255.255.0",
      "gateway": "192.168.1.1"
    },
    {
      "name": "WebServer",
      "ip": "192.168.2.10",
      "mask": "255.255.255.0",
      "gateway": "192.168.2.1"
    }
  ],
  "cliSteps": [
    {
      "device": "R1",
      "summary": "Configure interfaces and Extended Named ACL FILTER_LAN inbound on Gi0/0",
      "commands": [
        "enable",
        "configure terminal",
        "hostname R1",
        "no ip domain-lookup",
        "ip access-list extended FILTER_LAN",
        " permit tcp 192.168.1.0 0.0.0.255 host 192.168.2.10 eq 80",
        " deny icmp host 192.168.1.10 host 192.168.2.10",
        " permit ip any any",
        "interface GigabitEthernet0/0",
        " ip address 192.168.1.1 255.255.255.0",
        " ip access-group FILTER_LAN in",
        " no shutdown",
        "interface GigabitEthernet0/1",
        " ip address 192.168.2.1 255.255.255.0",
        " no shutdown",
        "end",
        "write memory"
      ]
    }
  ],
  "objectives": [
    {
      "type": "config_contains",
      "device": "R1",
      "text": "ip access-list extended FILTER_LAN"
    },
    {
      "type": "interface_up",
      "device": "R1",
      "interface": "GigabitEthernet0/0",
      "expected_ip": "192.168.1.1"
    }
  ]
}
