{
  "id": "acl-standard",
  "title": "Standard IPv4 Access Control List (ACL)",
  "summary": "Block a specific host (192.168.1.10) from reaching the server subnet (192.168.2.0/24) while permitting all other LAN hosts.",
  "learningObjectives": [
    "Write a standard numbered ACL (1–99) denying one host and permitting the rest",
    "Apply standard ACLs close to the destination (`ip access-group 10 out`)",
    "Verify hit counts using `show access-lists`"
  ],
  "devices": [
    {
      "name": "PC-Denied",
      "model": "PC-PT",
      "ptType": "PC-PT",
      "x": 100,
      "y": 180
    },
    {
      "name": "PC-Allowed",
      "model": "PC-PT",
      "ptType": "PC-PT",
      "x": 100,
      "y": 320
    },
    {
      "name": "SW1",
      "model": "2960-24TT",
      "ptType": "2960-24TT",
      "x": 260,
      "y": 240
    },
    {
      "name": "R1",
      "model": "2911",
      "ptType": "2911",
      "x": 460,
      "y": 240
    },
    {
      "name": "Server1",
      "model": "Server-PT",
      "ptType": "Server-PT",
      "x": 680,
      "y": 240
    }
  ],
  "links": [
    {
      "from": "PC-Denied",
      "fromPort": "FastEthernet0",
      "to": "SW1",
      "toPort": "FastEthernet0/1",
      "cable": "straight"
    },
    {
      "from": "PC-Allowed",
      "fromPort": "FastEthernet0",
      "to": "SW1",
      "toPort": "FastEthernet0/2",
      "cable": "straight"
    },
    {
      "from": "SW1",
      "fromPort": "GigabitEthernet0/1",
      "to": "R1",
      "toPort": "GigabitEthernet0/0",
      "cable": "straight"
    },
    {
      "from": "R1",
      "fromPort": "GigabitEthernet0/1",
      "to": "Server1",
      "toPort": "FastEthernet0",
      "cable": "cross"
    }
  ],
  "pcs": [
    {
      "name": "PC-Denied",
      "ip": "192.168.1.10",
      "mask": "255.255.255.0",
      "gateway": "192.168.1.1"
    },
    {
      "name": "PC-Allowed",
      "ip": "192.168.1.11",
      "mask": "255.255.255.0",
      "gateway": "192.168.1.1"
    },
    {
      "name": "Server1",
      "ip": "192.168.2.10",
      "mask": "255.255.255.0",
      "gateway": "192.168.2.1"
    }
  ],
  "cliSteps": [
    {
      "device": "R1",
      "summary": "Configure interfaces and apply Standard ACL 10 outbound on server interface",
      "commands": [
        "enable",
        "configure terminal",
        "hostname R1",
        "no ip domain-lookup",
        "interface GigabitEthernet0/0",
        " ip address 192.168.1.1 255.255.255.0",
        " no shutdown",
        "interface GigabitEthernet0/1",
        " ip address 192.168.2.1 255.255.255.0",
        " ip access-group 10 out",
        " no shutdown",
        "exit",
        "access-list 10 deny host 192.168.1.10",
        "access-list 10 permit any",
        "end",
        "write memory"
      ]
    }
  ],
  "objectives": [
    {
      "type": "config_contains",
      "device": "R1",
      "text": "ip access-group 10 out"
    },
    {
      "type": "ping",
      "from": "PC-Allowed",
      "to": "Server1"
    }
  ]
}
