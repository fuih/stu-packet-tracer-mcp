{
  "id": "inter-vlan-roas",
  "title": "Inter-VLAN Routing (Router-on-a-Stick)",
  "summary": "Route between VLAN 10 and VLAN 20 using 802.1Q subinterfaces (`Gi0/0.10`, `Gi0/0.20`) on a single router link.",
  "learningObjectives": [
    "Configure switch trunk port to the router",
    "Create 802.1Q subinterfaces with matching VLAN tags on the router",
    "Verify cross-VLAN ping from VLAN 10 to VLAN 20"
  ],
  "devices": [
    {
      "name": "R1",
      "model": "2911",
      "ptType": "2911",
      "x": 420,
      "y": 120
    },
    {
      "name": "SW1",
      "model": "2960-24TT",
      "ptType": "2960-24TT",
      "x": 420,
      "y": 260
    },
    {
      "name": "PC-10",
      "model": "PC-PT",
      "ptType": "PC-PT",
      "x": 240,
      "y": 380
    },
    {
      "name": "PC-20",
      "model": "PC-PT",
      "ptType": "PC-PT",
      "x": 600,
      "y": 380
    }
  ],
  "links": [
    {
      "from": "R1",
      "fromPort": "GigabitEthernet0/0",
      "to": "SW1",
      "toPort": "GigabitEthernet0/1",
      "cable": "straight"
    },
    {
      "from": "PC-10",
      "fromPort": "FastEthernet0",
      "to": "SW1",
      "toPort": "FastEthernet0/1",
      "cable": "straight"
    },
    {
      "from": "PC-20",
      "fromPort": "FastEthernet0",
      "to": "SW1",
      "toPort": "FastEthernet0/2",
      "cable": "straight"
    }
  ],
  "pcs": [
    {
      "name": "PC-10",
      "ip": "192.168.10.10",
      "mask": "255.255.255.0",
      "gateway": "192.168.10.1"
    },
    {
      "name": "PC-20",
      "ip": "192.168.20.10",
      "mask": "255.255.255.0",
      "gateway": "192.168.20.1"
    }
  ],
  "cliSteps": [
    {
      "device": "SW1",
      "summary": "Create VLANs 10 & 20, assign access ports, trunk uplink to router",
      "commands": [
        "enable",
        "configure terminal",
        "hostname SW1",
        "vlan 10",
        " name SALES",
        "vlan 20",
        " name ENGINEERING",
        "interface FastEthernet0/1",
        " switchport mode access",
        " switchport access vlan 10",
        "interface FastEthernet0/2",
        " switchport mode access",
        " switchport access vlan 20",
        "interface GigabitEthernet0/1",
        " switchport mode trunk",
        " switchport trunk allowed vlan 10,20",
        "end",
        "write memory"
      ]
    },
    {
      "device": "R1",
      "summary": "Bring up Gi0/0 and create dot1Q subinterfaces .10 and .20",
      "commands": [
        "enable",
        "configure terminal",
        "hostname R1",
        "no ip domain-lookup",
        "interface GigabitEthernet0/0",
        " no shutdown",
        "interface GigabitEthernet0/0.10",
        " encapsulation dot1Q 10",
        " ip address 192.168.10.1 255.255.255.0",
        "interface GigabitEthernet0/0.20",
        " encapsulation dot1Q 20",
        " ip address 192.168.20.1 255.255.255.0",
        "end",
        "write memory"
      ]
    }
  ],
  "objectives": [
    {
      "type": "vlan_exists",
      "device": "SW1",
      "vlan": 10
    },
    {
      "type": "vlan_exists",
      "device": "SW1",
      "vlan": 20
    },
    {
      "type": "config_contains",
      "device": "R1",
      "text": "encapsulation dot1Q 10"
    },
    {
      "type": "ping",
      "from": "PC-10",
      "to": "PC-20"
    }
  ]
}
