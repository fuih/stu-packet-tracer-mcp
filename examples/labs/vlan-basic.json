{
  "id": "vlan-basic",
  "title": "Basic VLAN Segmentation Across Two Switches",
  "summary": "Create VLAN 10 (Students) and VLAN 20 (Faculty) on two Catalyst 2960 switches linked by an 802.1Q trunk.",
  "learningObjectives": [
    "Create named VLANs and assign access ports",
    "Configure an 802.1Q trunk between switches",
    "Verify same-VLAN hosts communicate while different VLANs stay isolated"
  ],
  "devices": [
    {
      "name": "PC-S1",
      "model": "PC-PT",
      "ptType": "PC-PT",
      "x": 100,
      "y": 180
    },
    {
      "name": "PC-F1",
      "model": "PC-PT",
      "ptType": "PC-PT",
      "x": 100,
      "y": 320
    },
    {
      "name": "SW1",
      "model": "2960-24TT",
      "ptType": "2960-24TT",
      "x": 300,
      "y": 240
    },
    {
      "name": "SW2",
      "model": "2960-24TT",
      "ptType": "2960-24TT",
      "x": 540,
      "y": 240
    },
    {
      "name": "PC-S2",
      "model": "PC-PT",
      "ptType": "PC-PT",
      "x": 740,
      "y": 180
    },
    {
      "name": "PC-F2",
      "model": "PC-PT",
      "ptType": "PC-PT",
      "x": 740,
      "y": 320
    }
  ],
  "links": [
    {
      "from": "PC-S1",
      "fromPort": "FastEthernet0",
      "to": "SW1",
      "toPort": "FastEthernet0/1",
      "cable": "straight"
    },
    {
      "from": "PC-F1",
      "fromPort": "FastEthernet0",
      "to": "SW1",
      "toPort": "FastEthernet0/2",
      "cable": "straight"
    },
    {
      "from": "SW1",
      "fromPort": "GigabitEthernet0/1",
      "to": "SW2",
      "toPort": "GigabitEthernet0/1",
      "cable": "cross"
    },
    {
      "from": "PC-S2",
      "fromPort": "FastEthernet0",
      "to": "SW2",
      "toPort": "FastEthernet0/1",
      "cable": "straight"
    },
    {
      "from": "PC-F2",
      "fromPort": "FastEthernet0",
      "to": "SW2",
      "toPort": "FastEthernet0/2",
      "cable": "straight"
    }
  ],
  "pcs": [
    {
      "name": "PC-S1",
      "ip": "192.168.10.11",
      "mask": "255.255.255.0",
      "gateway": "192.168.10.1"
    },
    {
      "name": "PC-S2",
      "ip": "192.168.10.12",
      "mask": "255.255.255.0",
      "gateway": "192.168.10.1"
    },
    {
      "name": "PC-F1",
      "ip": "192.168.20.11",
      "mask": "255.255.255.0",
      "gateway": "192.168.20.1"
    },
    {
      "name": "PC-F2",
      "ip": "192.168.20.12",
      "mask": "255.255.255.0",
      "gateway": "192.168.20.1"
    }
  ],
  "cliSteps": [
    {
      "device": "SW1",
      "summary": "Create VLANs 10 & 20, assign access ports, configure trunk on Gi0/1",
      "commands": [
        "enable",
        "configure terminal",
        "hostname SW1",
        "vlan 10",
        " name STUDENTS",
        "vlan 20",
        " name FACULTY",
        "interface FastEthernet0/1",
        " switchport mode access",
        " switchport access vlan 10",
        "interface FastEthernet0/2",
        " switchport mode access",
        " switchport access vlan 20",
        "interface GigabitEthernet0/1",
        " switchport mode trunk",
        " switchport trunk allowed vlan 10,20",
        "end",
        "write memory"
      ]
    },
    {
      "device": "SW2",
      "summary": "Mirror VLANs 10 & 20, access ports, and trunk on Gi0/1",
      "commands": [
        "enable",
        "configure terminal",
        "hostname SW2",
        "vlan 10",
        " name STUDENTS",
        "vlan 20",
        " name FACULTY",
        "interface FastEthernet0/1",
        " switchport mode access",
        " switchport access vlan 10",
        "interface FastEthernet0/2",
        " switchport mode access",
        " switchport access vlan 20",
        "interface GigabitEthernet0/1",
        " switchport mode trunk",
        " switchport trunk allowed vlan 10,20",
        "end",
        "write memory"
      ]
    }
  ],
  "objectives": [
    {
      "type": "vlan_exists",
      "device": "SW1",
      "vlan": 10,
      "name": "STUDENTS"
    },
    {
      "type": "vlan_exists",
      "device": "SW2",
      "vlan": 20,
      "name": "FACULTY"
    },
    {
      "type": "ping",
      "from": "PC-S1",
      "to": "PC-S2"
    },
    {
      "type": "ping",
      "from": "PC-F1",
      "to": "PC-F2"
    }
  ]
}
