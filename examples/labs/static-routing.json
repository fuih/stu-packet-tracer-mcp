{
  "id": "static-routing",
  "title": "Static Routing Between Two LANs",
  "summary": "Two routers (R1, R2) connected over a point-to-point link (10.0.0.0/30) routing between LAN A (192.168.1.0/24) and LAN B (192.168.2.0/24) via static routes.",
  "learningObjectives": [
    "Configure router LAN and WAN interfaces with IPv4 addresses and `no shutdown`",
    "Configure bidirectional static routes (`ip route`) between remote subnets",
    "Verify routing tables and end-to-end PC connectivity"
  ],
  "devices": [
    {
      "name": "PC-A",
      "model": "PC-PT",
      "ptType": "PC-PT",
      "x": 100,
      "y": 260
    },
    {
      "name": "SW-A",
      "model": "2960-24TT",
      "ptType": "2960-24TT",
      "x": 240,
      "y": 260
    },
    {
      "name": "R1",
      "model": "2911",
      "ptType": "2911",
      "x": 380,
      "y": 180
    },
    {
      "name": "R2",
      "model": "2911",
      "ptType": "2911",
      "x": 600,
      "y": 180
    },
    {
      "name": "SW-B",
      "model": "2960-24TT",
      "ptType": "2960-24TT",
      "x": 740,
      "y": 260
    },
    {
      "name": "PC-B",
      "model": "PC-PT",
      "ptType": "PC-PT",
      "x": 880,
      "y": 260
    }
  ],
  "links": [
    {
      "from": "PC-A",
      "fromPort": "FastEthernet0",
      "to": "SW-A",
      "toPort": "FastEthernet0/1",
      "cable": "straight"
    },
    {
      "from": "SW-A",
      "fromPort": "GigabitEthernet0/1",
      "to": "R1",
      "toPort": "GigabitEthernet0/0",
      "cable": "straight"
    },
    {
      "from": "R1",
      "fromPort": "GigabitEthernet0/1",
      "to": "R2",
      "toPort": "GigabitEthernet0/1",
      "cable": "cross"
    },
    {
      "from": "R2",
      "fromPort": "GigabitEthernet0/0",
      "to": "SW-B",
      "toPort": "GigabitEthernet0/1",
      "cable": "straight"
    },
    {
      "from": "SW-B",
      "fromPort": "FastEthernet0/1",
      "to": "PC-B",
      "toPort": "FastEthernet0",
      "cable": "straight"
    }
  ],
  "pcs": [
    {
      "name": "PC-A",
      "ip": "192.168.1.10",
      "mask": "255.255.255.0",
      "gateway": "192.168.1.1"
    },
    {
      "name": "PC-B",
      "ip": "192.168.2.10",
      "mask": "255.255.255.0",
      "gateway": "192.168.2.1"
    }
  ],
  "cliSteps": [
    {
      "device": "R1",
      "summary": "Configure LAN, transit link, and static route to LAN B",
      "commands": [
        "enable",
        "configure terminal",
        "hostname R1",
        "no ip domain-lookup",
        "interface GigabitEthernet0/0",
        " ip address 192.168.1.1 255.255.255.0",
        " no shutdown",
        "interface GigabitEthernet0/1",
        " ip address 10.0.0.1 255.255.255.252",
        " no shutdown",
        "exit",
        "ip route 192.168.2.0 255.255.255.0 10.0.0.2",
        "end",
        "write memory"
      ]
    },
    {
      "device": "R2",
      "summary": "Configure LAN, transit link, and static route to LAN A",
      "commands": [
        "enable",
        "configure terminal",
        "hostname R2",
        "no ip domain-lookup",
        "interface GigabitEthernet0/0",
        " ip address 192.168.2.1 255.255.255.0",
        " no shutdown",
        "interface GigabitEthernet0/1",
        " ip address 10.0.0.2 255.255.255.252",
        " no shutdown",
        "exit",
        "ip route 192.168.1.0 255.255.255.0 10.0.0.1",
        "end",
        "write memory"
      ]
    }
  ],
  "objectives": [
    {
      "type": "route",
      "device": "R1",
      "prefix": "192.168.2.0/24",
      "next_hop": "10.0.0.2"
    },
    {
      "type": "route",
      "device": "R2",
      "prefix": "192.168.1.0/24",
      "next_hop": "10.0.0.1"
    },
    {
      "type": "ping",
      "from": "PC-A",
      "to": "PC-B"
    }
  ]
}
