{
  "id": "rip-v2",
  "title": "Dynamic Routing with RIPv2",
  "summary": "Two routers running RIP version 2 with `no auto-summary` exchanging LAN prefixes automatically.",
  "learningObjectives": [
    "Enable RIPv2 (`version 2`, `no auto-summary`) and advertise classless networks",
    "Configure `passive-interface` on LAN ports",
    "Verify `R` routes in `show ip route`"
  ],
  "devices": [
    {
      "name": "PC-A",
      "model": "PC-PT",
      "ptType": "PC-PT",
      "x": 100,
      "y": 240
    },
    {
      "name": "R1",
      "model": "2911",
      "ptType": "2911",
      "x": 320,
      "y": 180
    },
    {
      "name": "R2",
      "model": "2911",
      "ptType": "2911",
      "x": 560,
      "y": 180
    },
    {
      "name": "PC-B",
      "model": "PC-PT",
      "ptType": "PC-PT",
      "x": 780,
      "y": 240
    }
  ],
  "links": [
    {
      "from": "PC-A",
      "fromPort": "FastEthernet0",
      "to": "R1",
      "toPort": "GigabitEthernet0/0",
      "cable": "cross"
    },
    {
      "from": "R1",
      "fromPort": "GigabitEthernet0/1",
      "to": "R2",
      "toPort": "GigabitEthernet0/1",
      "cable": "cross"
    },
    {
      "from": "R2",
      "fromPort": "GigabitEthernet0/0",
      "to": "PC-B",
      "toPort": "FastEthernet0",
      "cable": "cross"
    }
  ],
  "pcs": [
    {
      "name": "PC-A",
      "ip": "192.168.1.10",
      "mask": "255.255.255.0",
      "gateway": "192.168.1.1"
    },
    {
      "name": "PC-B",
      "ip": "192.168.2.10",
      "mask": "255.255.255.0",
      "gateway": "192.168.2.1"
    }
  ],
  "cliSteps": [
    {
      "device": "R1",
      "summary": "Configure interfaces and RIPv2",
      "commands": [
        "enable",
        "configure terminal",
        "hostname R1",
        "no ip domain-lookup",
        "interface GigabitEthernet0/0",
        " ip address 192.168.1.1 255.255.255.0",
        " no shutdown",
        "interface GigabitEthernet0/1",
        " ip address 10.0.0.1 255.255.255.252",
        " no shutdown",
        "router rip",
        " version 2",
        " no auto-summary",
        " network 192.168.1.0",
        " network 10.0.0.0",
        " passive-interface GigabitEthernet0/0",
        "end",
        "write memory"
      ]
    },
    {
      "device": "R2",
      "summary": "Configure interfaces and RIPv2",
      "commands": [
        "enable",
        "configure terminal",
        "hostname R2",
        "no ip domain-lookup",
        "interface GigabitEthernet0/0",
        " ip address 192.168.2.1 255.255.255.0",
        " no shutdown",
        "interface GigabitEthernet0/1",
        " ip address 10.0.0.2 255.255.255.252",
        " no shutdown",
        "router rip",
        " version 2",
        " no auto-summary",
        " network 192.168.2.0",
        " network 10.0.0.0",
        " passive-interface GigabitEthernet0/0",
        "end",
        "write memory"
      ]
    }
  ],
  "objectives": [
    {
      "type": "config_contains",
      "device": "R1",
      "text": "version 2"
    },
    {
      "type": "route",
      "device": "R1",
      "prefix": "192.168.2.0/24"
    },
    {
      "type": "ping",
      "from": "PC-A",
      "to": "PC-B"
    }
  ]
}
