{
  "id": "nat-pat",
  "title": "NAT Overload (PAT) to ISP",
  "summary": "Translate private LAN hosts (192.168.1.0/24) to the edge router's outside public interface using PAT (`overload`).",
  "learningObjectives": [
    "Mark `ip nat inside` and `ip nat outside` interfaces",
    "Match private source traffic with an ACL and bind `ip nat inside source list 1 interface Gi0/1 overload`",
    "Verify translations in `show ip nat translations`"
  ],
  "devices": [
    {
      "name": "PC-LAN",
      "model": "PC-PT",
      "ptType": "PC-PT",
      "x": 100,
      "y": 240
    },
    {
      "name": "R1",
      "model": "2911",
      "ptType": "2911",
      "x": 340,
      "y": 180
    },
    {
      "name": "ISP",
      "model": "2911",
      "ptType": "2911",
      "x": 580,
      "y": 180
    },
    {
      "name": "WebServer",
      "model": "Server-PT",
      "ptType": "Server-PT",
      "x": 800,
      "y": 240
    }
  ],
  "links": [
    {
      "from": "PC-LAN",
      "fromPort": "FastEthernet0",
      "to": "R1",
      "toPort": "GigabitEthernet0/0",
      "cable": "cross"
    },
    {
      "from": "R1",
      "fromPort": "GigabitEthernet0/1",
      "to": "ISP",
      "toPort": "GigabitEthernet0/1",
      "cable": "cross"
    },
    {
      "from": "ISP",
      "fromPort": "GigabitEthernet0/0",
      "to": "WebServer",
      "toPort": "FastEthernet0",
      "cable": "cross"
    }
  ],
  "pcs": [
    {
      "name": "PC-LAN",
      "ip": "192.168.1.10",
      "mask": "255.255.255.0",
      "gateway": "192.168.1.1"
    },
    {
      "name": "WebServer",
      "ip": "203.0.113.10",
      "mask": "255.255.255.0",
      "gateway": "203.0.113.1"
    }
  ],
  "cliSteps": [
    {
      "device": "R1",
      "summary": "Configure inside/outside interfaces, default route, and PAT overload",
      "commands": [
        "enable",
        "configure terminal",
        "hostname R1",
        "no ip domain-lookup",
        "interface GigabitEthernet0/0",
        " ip address 192.168.1.1 255.255.255.0",
        " ip nat inside",
        " no shutdown",
        "interface GigabitEthernet0/1",
        " ip address 198.51.100.2 255.255.255.252",
        " ip nat outside",
        " no shutdown",
        "exit",
        "access-list 1 permit 192.168.1.0 0.0.0.255",
        "ip nat inside source list 1 interface GigabitEthernet0/1 overload",
        "ip route 0.0.0.0 0.0.0.0 198.51.100.1",
        "end",
        "write memory"
      ]
    },
    {
      "device": "ISP",
      "summary": "Configure ISP transit and public web server LAN (no private route needed!)",
      "commands": [
        "enable",
        "configure terminal",
        "hostname ISP",
        "no ip domain-lookup",
        "interface GigabitEthernet0/1",
        " ip address 198.51.100.1 255.255.255.252",
        " no shutdown",
        "interface GigabitEthernet0/0",
        " ip address 203.0.113.1 255.255.255.0",
        " no shutdown",
        "end",
        "write memory"
      ]
    }
  ],
  "objectives": [
    {
      "type": "config_contains",
      "device": "R1",
      "text": "ip nat inside source list 1"
    },
    {
      "type": "ping",
      "from": "PC-LAN",
      "to": "WebServer"
    }
  ]
}
