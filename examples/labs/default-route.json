{
  "id": "default-route",
  "title": "Stub Router Default Route (`0.0.0.0/0`)",
  "summary": "Stub branch router (R1) forwarding all unknown traffic via a default route to headquarters router (R2).",
  "learningObjectives": [
    "Configure a default static route (`ip route 0.0.0.0 0.0.0.0`) on a stub router",
    "Observe `S* 0.0.0.0/0` and Gateway of last resort in `show ip route`"
  ],
  "devices": [
    {
      "name": "PC-A",
      "model": "PC-PT",
      "ptType": "PC-PT",
      "x": 100,
      "y": 240
    },
    {
      "name": "R1",
      "model": "2911",
      "ptType": "2911",
      "x": 320,
      "y": 180
    },
    {
      "name": "R2",
      "model": "2911",
      "ptType": "2911",
      "x": 560,
      "y": 180
    },
    {
      "name": "Server-HQ",
      "model": "Server-PT",
      "ptType": "Server-PT",
      "x": 780,
      "y": 240
    }
  ],
  "links": [
    {
      "from": "PC-A",
      "fromPort": "FastEthernet0",
      "to": "R1",
      "toPort": "GigabitEthernet0/0",
      "cable": "cross"
    },
    {
      "from": "R1",
      "fromPort": "GigabitEthernet0/1",
      "to": "R2",
      "toPort": "GigabitEthernet0/1",
      "cable": "cross"
    },
    {
      "from": "R2",
      "fromPort": "GigabitEthernet0/0",
      "to": "Server-HQ",
      "toPort": "FastEthernet0",
      "cable": "cross"
    }
  ],
  "pcs": [
    {
      "name": "PC-A",
      "ip": "192.168.1.10",
      "mask": "255.255.255.0",
      "gateway": "192.168.1.1"
    },
    {
      "name": "Server-HQ",
      "ip": "192.168.2.100",
      "mask": "255.255.255.0",
      "gateway": "192.168.2.1"
    }
  ],
  "cliSteps": [
    {
      "device": "R1",
      "summary": "Configure stub router with default route to HQ",
      "commands": [
        "enable",
        "configure terminal",
        "hostname R1",
        "no ip domain-lookup",
        "interface GigabitEthernet0/0",
        " ip address 192.168.1.1 255.255.255.0",
        " no shutdown",
        "interface GigabitEthernet0/1",
        " ip address 10.0.0.1 255.255.255.252",
        " no shutdown",
        "exit",
        "ip route 0.0.0.0 0.0.0.0 10.0.0.2",
        "end",
        "write memory"
      ]
    },
    {
      "device": "R2",
      "summary": "Configure HQ router with return route to branch LAN",
      "commands": [
        "enable",
        "configure terminal",
        "hostname R2",
        "no ip domain-lookup",
        "interface GigabitEthernet0/0",
        " ip address 192.168.2.1 255.255.255.0",
        " no shutdown",
        "interface GigabitEthernet0/1",
        " ip address 10.0.0.2 255.255.255.252",
        " no shutdown",
        "exit",
        "ip route 192.168.1.0 255.255.255.0 10.0.0.1",
        "end",
        "write memory"
      ]
    }
  ],
  "objectives": [
    {
      "type": "route",
      "device": "R1",
      "prefix": "0.0.0.0/0",
      "next_hop": "10.0.0.2"
    },
    {
      "type": "ping",
      "from": "PC-A",
      "to": "Server-HQ"
    }
  ]
}
